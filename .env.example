# Mapbox public token — used in the browser to render the map
# Get yours at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Mapbox secret token — used server-side for geocoding
# Must have the Geocoding scope enabled
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret_token_here
